# Copy to server/.env and fill in real values. Never commit server/.env.
MONGO_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/your-db
JWT_SECRET=your-long-random-secret-here
PORT=8000

# Gmail account and app password used by EmailController (nodemailer)
EMAIL_USER=your-gmail-address
EMAIL_PASS=your-gmail-app-password
